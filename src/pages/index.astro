---
import Base from '../layouts/Base.astro';
import BootScreen from '../components/BootScreen.astro';
import Logo from '../components/Logo.astro';
import Desktop from '../components/desktop/Desktop';
import { getPublishedPosts, toSummary } from '../lib/posts';
import { getDrops } from '../lib/drops';
import { POLICIES, SITE } from '../lib/site';

const posts = (await getPublishedPosts()).map(toSummary);
// Only the latest few of each kind ride along in the page; the rest live on /today/.
const LATEST = 8;
const allDrops = await getDrops();
const drops = [
  ...allDrops.filter((d) => d.kind === 'meme').slice(0, LATEST),
  ...allDrops.filter((d) => d.kind === 'video').slice(0, LATEST),
];
---

<Base>
  <h1 class="sr-only">{SITE.name}</h1>
  <BootScreen />
  <Desktop client:load posts={posts} drops={drops}>
    <Logo size="full" />
  </Desktop>

  <!-- Plain links for crawlers, screen readers and no-JS visitors. -->
  <nav class="sr-only" aria-label="Site">
    <ul>
      <li>
        <a href="/about/">About Internet Grails</a>
      </li>
      <li>
        <a href="/contact/">Contact</a>
      </li>
      {POLICIES.pages.map(({ href, label }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
      <li>
        <a href="/today/">Today's Grails</a>
      </li>
      {posts.map((p) => (
        <li>
          <a href={`/posts/${p.slug}/`}>{p.title}</a>
        </li>
      ))}
    </ul>
  </nav>
</Base>
