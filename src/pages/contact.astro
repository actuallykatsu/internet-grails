---
import WindowPage from '../layouts/WindowPage.astro';
import { SITE } from '../lib/site';
import ContactForm from '../components/ContactForm';
---

<WindowPage
  title="Contact"
  windowTitle="Contact - Internet Grails"
  description={`Official contact for ${SITE.name}: ${SITE.email}, X ${SITE.x.handle}.`}
>
  <h1>Contact {SITE.name}</h1>
  <p>
    <strong>Business &amp; press inquiries</strong> are welcome. Here's how to reach us officially.
  </p>

  <dl class="ig-official">
    <dt>Business name</dt>
    <dd>{SITE.name}</dd>
    <dt>Email</dt>
    <dd>
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </dd>
    <dt>X (official)</dt>
    <dd>
      <a href={SITE.x.url}>{SITE.x.handle}</a>
    </dd>
    <dt>TikTok (official)</dt>
    <dd>{SITE.tiktok ? <a href={SITE.tiktok.url}>{SITE.tiktok.handle}</a> : 'Coming soon'}</dd>
    <dt>Website</dt>
    <dd>
      <a href={SITE.url}>internetgrails.com</a>
    </dd>
  </dl>

  <h2>Send a message</h2>
  <ContactForm client:visible />
  <p class="ig-contact__privacy">
    We use your message only to reply. See the <a href="/privacy/">privacy policy</a>.
  </p>
</WindowPage>

<style>
  .ig-official {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 20px;
    padding: 14px 16px;
    background: #fff;
    box-shadow: var(--ig-bevel-in);
  }
  .ig-contact__privacy {
    font-size: 0.9rem;
  }
  .ig-official dt {
    font-weight: 700;
  }
  .ig-official dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
