---
/** Phase 0 mockup: the Music section's media player (D17). Placeholder tracks, no audio. */
import Base from '../../layouts/Base.astro';
import MediaPlayer, { type Track } from '../../components/MediaPlayer';

const tracks: Track[] = [
  { artist: 'Placeholder Artist', title: 'Dial-Up Dreams', length: 214 },
  { artist: 'Sample Band', title: 'Away Message', length: 187 },
  { artist: 'Lofi Stand-in', title: 'Screensaver Sunset', length: 243 },
  { artist: 'Demo Crew', title: 'Burned CD Track 7', length: 199 },
];
---

<Base title="Mockup: Media player" index={false}>
  <main class="ig-mockup">
    <p class="ig-mockup__note">
      Phase 0 mockup · <a href="/">back to desktop</a> · placeholder tracks, no audio yet
    </p>
    <MediaPlayer client:visible tracks={tracks} />
  </main>
</Base>

<style>
  .ig-mockup {
    min-height: 100vh;
    padding: 24px 16px;
    background: linear-gradient(160deg, var(--ig-desktop) 0%, var(--ig-desktop-deep) 100%);
  }
  .ig-mockup__note {
    color: #fff;
    text-align: center;
    font-family: var(--ig-font-chrome);
    font-size: 20px;
  }
  .ig-mockup__note a {
    color: var(--ig-accent-2);
  }

  /* Player skin. :global because the markup comes from the React island. */
  :global(.ig-player) {
    width: min(380px, 100%);
    margin: 24px auto;
    padding: 12px 14px 14px;
    border-radius: 22px 22px 14px 14px;
    background: var(--ig-metal);
    box-shadow:
      inset 0 0 0 2px var(--ig-ink),
      inset 0 3px 0 4px rgb(255 255 255 / 0.6),
      0 10px 24px rgb(0 0 0 / 0.45);
    font-family: var(--ig-font-chrome);
    color: var(--ig-ink);
  }
  :global(.ig-player__top) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 6px 8px;
  }
  :global(.ig-player__brand) {
    font-size: 22px;
    font-style: italic;
    letter-spacing: 1px;
    text-shadow: 0 1px 0 #fff;
  }
  :global(.ig-player__led) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #3a2a2a;
    box-shadow: inset 0 0 0 1px var(--ig-ink);
  }
  :global(.ig-player__led[data-on='true']) {
    background: var(--ig-online);
    box-shadow:
      inset 0 0 0 1px var(--ig-ink),
      0 0 6px var(--ig-online);
  }
  :global(.ig-player__lcd) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background: linear-gradient(180deg, #021a20, #04303a);
    box-shadow:
      inset 0 0 0 2px var(--ig-ink),
      inset 0 2px 8px rgb(0 0 0 / 0.7);
    color: var(--ig-accent-2);
    text-shadow: 0 0 4px rgb(51 225 255 / 0.6);
    font-size: 20px;
  }
  :global(.ig-player__now) {
    display: flex;
    gap: 8px;
    min-width: 0;
  }
  :global(.ig-player__marquee) {
    overflow: hidden;
    white-space: nowrap;
  }
  :global(.ig-player__marquee > span) {
    display: inline-block;
  }
  :global(.ig-player__marquee > span[data-scroll='true']) {
    animation: ig-marquee 9s linear infinite;
  }
  :global(.ig-player__viz) {
    grid-column: 1 / -1;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 54px;
  }
  :global(.ig-player__viz span) {
    flex: 1;
    height: 100%;
    transform-origin: bottom;
    background: linear-gradient(
      0deg,
      var(--ig-accent-2) 0 60%,
      #ffe066 60% 85%,
      var(--ig-accent) 85%
    );
    transition: transform 90ms linear;
  }
  :global(.ig-player__seek input),
  :global(.ig-player__vol input) {
    width: 100%;
    accent-color: var(--ig-title-active-b);
  }
  :global(.ig-player__seek) {
    display: block;
    margin: 10px 2px 6px;
  }
  :global(.ig-player__controls) {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  :global(.ig-player__btn) {
    min-width: 40px;
    height: 36px;
    border: 0;
    border-radius: 18px;
    background: linear-gradient(180deg, #fff, #c9ced6 55%, #8f97a3);
    box-shadow: inset 0 0 0 2px var(--ig-ink);
    font: inherit;
    font-size: 18px;
    cursor: pointer;
  }
  :global(.ig-player__btn--play) {
    min-width: 52px;
    background: linear-gradient(180deg, #8fd8ff, #3a76d8 60%, #0b1f6b);
    color: #fff;
  }
  :global(.ig-player__btn--small) {
    padding: 0 10px;
    font-size: 16px;
  }
  :global(.ig-player__btn[aria-pressed='true']:not(.ig-player__btn--play)) {
    background: linear-gradient(180deg, #ffd1ea, #ff3ea5);
  }
  :global(.ig-player__btn:focus-visible) {
    outline: 2px solid var(--ig-accent);
    outline-offset: 2px;
  }
  :global(.ig-player__vol) {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: 1;
    min-width: 70px;
    font-size: 16px;
  }
  :global(.ig-player__list) {
    list-style: none;
    margin: 10px 0 0;
    padding: 4px;
    border-radius: 6px;
    background: #021a20;
    box-shadow: inset 0 0 0 2px var(--ig-ink);
  }
  :global(.ig-player__list button) {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 3px 6px;
    border: 0;
    background: none;
    color: #9fd9e6;
    font: inherit;
    font-size: 18px;
    text-align: left;
    cursor: pointer;
  }
  :global(.ig-player__list button[aria-current='true']) {
    background: var(--ig-title-active-b);
    color: #fff;
  }
  :global(.ig-player__list button:hover) {
    color: #fff;
  }
  @keyframes -global-ig-marquee {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.ig-player__viz span) {
      transition: none;
    }
  }
</style>
