---
import Logo from './Logo.astro';
---

<!--
  Plays once per session. Skippable with any click or key.
  Skipped automatically for reduced-motion visitors and returning tabs.
  The "click to start" moment is also where the media player can be unlocked later.
-->
<div id="ig-boot" class="ig-boot" role="dialog" aria-label="Starting Internet Grails" hidden>
  <pre class="ig-boot__bios" aria-hidden="true"></pre>
  <div class="ig-boot__logo">
    <Logo size="full" />
    <p class="ig-boot__hint">Click or press any key to start</p>
  </div>
  <button class="ig-boot__skip ig-btn" type="button">
    Skip
  </button>
</div>

<script is:inline>
  (() => {
    const boot = document.getElementById('ig-boot');
    if (!boot) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let seen = false;
    try {
      seen = sessionStorage.getItem('ig-booted') === '1';
    } catch {
      /* storage blocked: just play it */
    }
    if (reduce || seen) return;
    boot.hidden = false;

    const lines = [
      'GrailBIOS v4.20  (C) 1999-2026 Internet Grails',
      'Detecting memes ............ OK',
      'Loading vibes .............. OK',
      'Mounting /dev/trends ....... OK',
      'Dialing 56k ................ CONNECTED',
      '',
    ];
    const bios = boot.querySelector('.ig-boot__bios');
    let i = 0;
    const timer = setInterval(() => {
      if (i < lines.length) {
        bios.textContent += lines[i++] + '\n';
      } else {
        clearInterval(timer);
        boot.classList.add('ig-boot--logo');
      }
    }, 260);

    const finish = () => {
      clearInterval(timer);
      try {
        sessionStorage.setItem('ig-booted', '1');
      } catch {
        /* ignore */
      }
      boot.classList.add('ig-boot--out');
      setTimeout(() => boot.remove(), 350);
      window.removeEventListener('keydown', finish);
      boot.removeEventListener('click', finish);
      document.dispatchEvent(new CustomEvent('ig:booted'));
    };
    window.addEventListener('keydown', finish);
    boot.addEventListener('click', finish);
  })();
</script>

<style>
  .ig-boot {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #000;
    color: #c8c8c8;
    font-family: var(--ig-font-chrome);
    font-size: 22px;
    cursor: pointer;
    transition: opacity 350ms var(--ig-ease);
  }
  .ig-boot[hidden] {
    display: none;
  }
  .ig-boot__bios {
    margin: 0;
    padding: 24px;
    font: inherit;
    white-space: pre-wrap;
  }
  .ig-boot__logo {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 500ms var(--ig-ease),
      transform 500ms var(--ig-ease);
    pointer-events: none;
  }
  .ig-boot--logo .ig-boot__bios {
    opacity: 0;
  }
  .ig-boot--logo .ig-boot__logo {
    opacity: 1;
    transform: none;
  }
  .ig-boot__logo :global(.ig-logo) {
    width: min(80vw, 520px);
    filter: drop-shadow(0 0 18px rgb(51 225 255 / 0.35));
  }
  .ig-boot--logo .ig-boot__logo :global(.ig-logo) {
    animation: ig-coin 1.4s var(--ig-ease) both;
  }
  .ig-boot__hint {
    margin: 0;
    animation: ig-blink 1.1s steps(2) infinite;
  }
  .ig-boot__skip {
    position: absolute;
    right: 16px;
    bottom: 16px;
  }
  .ig-boot--out {
    opacity: 0;
  }
  @keyframes ig-blink {
    50% {
      opacity: 0;
    }
  }
</style>
