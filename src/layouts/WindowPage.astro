---
/**
 * A real, linkable page that renders as a maximized window on the desktop,
 * so articles, Contact and About read like normal pages but wear the chrome.
 */
import Base from './Base.astro';
import Taskbar from '../components/desktop/Taskbar';
import { SECTIONS } from '../lib/site';
import { getPublishedPosts, toSummary } from '../lib/posts';
import { tickerItems } from '../lib/ticker';
import { PLAYER_START_ITEM, type StartItem } from '../components/desktop/Taskbar';

interface Props {
  title: string;
  windowTitle?: string;
  description?: string;
  index?: boolean;
  /** Where the phone layout's back arrow goes (D20). */
  backHref?: string;
  /** Include this page's content in site search (D24). Articles only. */
  searchable?: boolean;
}

const {
  title,
  windowTitle = title,
  description,
  index,
  backHref = '/',
  searchable = false,
} = Astro.props;

const startItems: StartItem[] = [
  { label: 'Desktop', icon: 'desktop', href: '/' },
  ...SECTIONS.map(({ id, label, icon }) => ({ label, icon, href: `/?w=${id}` })),
  { label: "Today's Grails", icon: 'news', href: '/today/' },
  { label: 'Contact', icon: 'contact', href: '/contact/' },
  { label: 'Search', icon: 'search', href: '/?w=search' },
  { label: 'About', icon: 'about', href: '/about/' },
  PLAYER_START_ITEM,
];
const ticker = tickerItems((await getPublishedPosts()).map(toSummary));
---

<Base title={title} description={description} index={index}>
  <div class="ig-page">
    <article class="ig-window ig-page__window" data-active="true">
      <div class="ig-titlebar">
        <a class="ig-titlebar__back" href={backHref} aria-label="Back">
          ‹
        </a>
        <span class="ig-titlebar__title">{windowTitle}</span>
        <a class="ig-titlebar__btn" href="/" aria-label="Minimize to desktop">
          _
        </a>
        <a class="ig-titlebar__btn" href="/" aria-label="Close and return to desktop">
          ×
        </a>
      </div>
      <div class="ig-window__body">
        <main class="ig-prose" data-pagefind-body={searchable ? '' : undefined}>
          <slot />
        </main>
      </div>
    </article>
  </div>
  <Taskbar client:idle startItems={startItems} ticker={ticker} />
</Base>

<style>
  .ig-page {
    min-height: 100vh;
    padding: 0 0 var(--ig-taskbar-h);
    background: linear-gradient(160deg, var(--ig-desktop) 0%, var(--ig-desktop-deep) 100%);
  }
  .ig-page__window {
    min-height: calc(100vh - var(--ig-taskbar-h));
    animation: ig-window-in var(--ig-dur) var(--ig-ease);
  }
  .ig-page__window .ig-titlebar {
    position: sticky;
    top: 0;
    z-index: 2;
  }
  .ig-titlebar__btn {
    text-decoration: none;
  }
  .ig-window__body {
    padding: clamp(16px, 4vw, 48px) clamp(14px, 4vw, 32px);
  }
  /* Phone layout (D20): the page sits under the status bar like a full-screen app. */
  @media (max-width: 700px) {
    .ig-page {
      padding-top: var(--ig-status-h);
    }
    .ig-page__window {
      min-height: calc(100vh - var(--ig-taskbar-h) - var(--ig-status-h));
    }
    .ig-page__window .ig-titlebar {
      top: var(--ig-status-h);
    }
  }
</style>
