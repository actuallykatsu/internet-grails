---
import '@fontsource/vt323';
import '@fontsource-variable/inter';
import '../styles/global.css';
import '../styles/desktop.css';
import '../styles/player.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, organizationJsonLd } from '../lib/site';
import GrailPlayer from '../components/player/GrailPlayer';
import { TRACKS } from '../lib/tracks';
import { SHARE_IMAGE_SIZE, shareImageFor } from '../lib/shareCards';

interface Props {
  title?: string;
  description?: string;
  /** Pass false for pages that shouldn't be indexed (e.g. mockups). */
  index?: boolean;
}

const { title, description = SITE.tagline, index = true } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// A build for any other address (the preview, D30) keeps out of search results, so it
// never competes with the real site.
const preview = Astro.site?.origin !== new URL(SITE.url).origin;
// Every page's share image is drawn as a retro window (D29).
const shareImage = new URL(await shareImageFor(Astro.url.pathname), Astro.site);
const shareAlt = `${title ?? SITE.name}, shown as a window on the ${SITE.name} desktop`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Tell other sites nothing about where visitors came from. X's video server
         (video.twimg.com) refuses requests that name another site as the referrer, so
         drop videos only play without one (D28). -->
    <meta name="referrer" content="same-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content={String(SHARE_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(SHARE_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:image:alt" content={shareAlt} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name}: drops`}
      href="/drops.xml"
    />
    {(!index || preview) && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.x.handle} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd())} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    {/* Persists across page changes so music keeps playing (D19). */}
    <GrailPlayer client:idle transition:persist="ig-player" tracks={TRACKS} />
  </body>
</html>
