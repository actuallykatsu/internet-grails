# Contact form service (D21). Copy to .env and fill in. Both values are public:
# they are built into the page. Leave the endpoint empty to fall back to email.
#
# Web3Forms: PUBLIC_CONTACT_ENDPOINT=https://api.web3forms.com/submit
#            PUBLIC_CONTACT_ACCESS_KEY=<access key from web3forms.com>
# Formspree: PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/<form id>
# PUBLIC_CONTACT_ENDPOINT=
# PUBLIC_CONTACT_ACCESS_KEY=
